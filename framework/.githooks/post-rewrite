#!/usr/bin/env bash
# Warn when a rebase brings in dependency changes that require a fresh install.
#
# Git calls post-rewrite with $1="rebase" after `git rebase` and
# `git pull --rebase`. Other callers (e.g. git commit --amend) pass "amend";
# we only care about rebase. This hook never blocks — it exits 0 regardless.
#
# Stack-agnostic: the pattern below covers the common JS package managers by default.
# Add your ecosystem's manifests/lockfiles here if different
# (e.g. requirements.txt|poetry.lock, go.mod|go.sum, Cargo.toml|Cargo.lock, Gemfile.lock).

set -euo pipefail

[ "${1:-}" = "rebase" ] || exit 0

DEP_FILES='(^|/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb)$'

changed=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null \
  | grep -E "$DEP_FILES" \
  || true)

if [ -n "$changed" ]; then
  echo "" >&2
  echo "📦  Dependencies changed — run your install command (e.g. pnpm install / npm install)" >&2
  echo "" >&2
fi
